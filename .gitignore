# 依赖与构建产物
node_modules/
dist/
dist-ssr/
*.local

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/

# 数据库与数据文件
# 注意：带 "/" 的 pattern 是相对 .gitignore 所在层级的，所以下面三条必须加 ** 前缀。
# 否则 backend/data/uploads/ 会漏网 —— 学员上传的实验报告会被提交进仓库。
*.db
*.sqlite
*.sqlite3
**/data/uploads/
**/data/_trash/
**/data/reports/

# 环境变量与密钥（严禁入库）
.env
.env.*
!.env.example

# 日志
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 本地临时文件
*.utf8.txt
check*.txt
listing*.txt
dev.log

# 编辑器 / 系统
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# 安装包
*.zip
*.tar.gz
